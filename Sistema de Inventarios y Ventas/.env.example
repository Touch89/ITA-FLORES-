# Signs the login session cookie (server/session.mjs). Generate a real one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this value invalidates every existing session (everyone gets logged out).
SESSION_SECRET=changeme_session_secret
